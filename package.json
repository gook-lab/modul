{
  "name": "modul",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint packages apps",
    "verify": "pnpm lint && pnpm typecheck && pnpm -r test",
    "changeset": "changeset",
    "release": "changeset version && pnpm install --lockfile-only && pnpm -r build && changeset publish",
    "gen:stories": "tsx scripts/gen-stories.ts",
    "codemod": "jscodeshift -t scripts/codemods/$0 --extensions=tsx,ts --parser=tsx",
    "size": "size-limit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.0",
    "@eslint/js": "^9.9.0",
    "@hookform/resolvers": "^5.9.1",
    "@size-limit/preset-small-lib": "^11.2.0",
    "@types/jscodeshift": "^0.11.11",
    "@types/node": "^26.4.1",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^19.2.7",
    "eslint": "^9.9.0",
    "eslint-plugin-jsx-a11y": "^6.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-storybook": "10.6.0",
    "jscodeshift": "^17.0.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-hook-form": "^7.87.0",
    "size-limit": "^11.2.0",
    "tsup": "^8.5.1",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^7",
    "zod": "^4.5.4",
    "vitest": "^4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "packageManager": "pnpm@10.34.1",
  "type": "module",
  "license": "MIT"
}
