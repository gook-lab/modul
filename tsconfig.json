{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node", "vite/client"],
    "baseUrl": ".",
    "paths": {
      "@gook-lab/ui": ["./packages/ui/src/index.ts"],
      "@gook-lab/ui/*": ["./packages/ui/src/*"],
      "@gook-lab/motion": ["./packages/motion/src/index.ts"],
      "@gook-lab/motion/*": ["./packages/motion/src/*"],
      "@gook-lab/icons": ["./packages/icons/src/index.tsx"],
      "@gook-lab/tokens": ["./packages/tokens/tokens.ts"],
      "@gook-lab/malt-ui": ["./packages/malt-ui/src/index.ts"]
    }
  },
  "include": ["packages", "apps", "scripts"],
  "exclude": ["**/node_modules", "**/dist", "**/storybook-static"]
}
