{
  "name": "@modul/motion",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "peerDependencies": {
    "@modul/tokens": "workspace:*",
    "react": ">=18"
  },
  "devDependencies": {
    "@storybook/react": "^8.6.18",
    "vitest": "^2.1.9",
    "tsup": "^8.3.0"
  },
  "scripts": {
    "test": "vitest run",
    "build": "tsup",
    "dev": "tsup --watch"
  },
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./*": {
      "import": {
        "types": "./dist/*.d.ts",
        "default": "./dist/*.js"
      },
      "require": {
        "types": "./dist/*.d.cts",
        "default": "./dist/*.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gook-lab/modul.git",
    "directory": "packages/motion"
  }
}
