{
  "name": "@malt/ui-web-next",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "description": "bottling ui-web 프리미티브의 headless 개정안 — 기존 계약 유지 + ...rest",
  "peerDependencies": {
    "react": ">=18",
    "@modul/ui": "workspace:*",
    "@modul/tokens": "workspace:*"
  },
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch"
  },
  "devDependencies": {
    "tsup": "^8.3.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gook-lab/modul.git",
    "directory": "packages/malt-ui"
  }
}
