{
  "name": "@gook-lab/malt-ui",
  "version": "0.1.1",
  "type": "module",
  "main": "./dist/index.cjs",
  "description": "bottling ui-web 프리미티브의 headless 개정안 — 기존 계약 유지 + ...rest",
  "peerDependencies": {
    "@gook-lab/tokens": "workspace:*",
    "@gook-lab/ui": "workspace:*",
    "react": ">=18"
  },
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "prepublishOnly": "pnpm build",
    "prepack": "node ../../scripts/assert-pnpm-publish.mjs",
    "test": "vitest run"
  },
  "devDependencies": {
    "@radix-ui/react-tabs": "^1.1.21",
    "@storybook/react-vite": "10.6.0",
    "@testing-library/jest-dom": "^6.4.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.0",
    "jsdom": "^24.1.0",
    "tsup": "^8.3.0",
    "vitest": "^4.1.11"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gook-lab/modul.git",
    "directory": "packages/malt-ui"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "dependencies": {
    "@radix-ui/react-toggle-group": "^1.1.19"
  }
}
