{
  "name": "@gook-lab/icons",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "peerDependencies": {
    "react": ">=18"
  },
  "dependencies": {
    "lucide-react": "^0.440.0"
  },
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "prepublishOnly": "pnpm build",
    "prepack": "node ../../scripts/assert-pnpm-publish.mjs"
  },
  "devDependencies": {
    "tsup": "^8.3.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gook-lab/modul.git",
    "directory": "packages/icons"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  }
}
